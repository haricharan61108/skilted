generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bid {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  bidAmount Float
  createdAt DateTime @default(now())
  comments  String?
  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, jobId], map: "bid_user_job_unique")
  @@index([jobId])
  @@index([userId])
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  chats    Chat[]
  jobs     Job[]
}

model Job {
  id                  Int        @id @default(autoincrement())
  title               String
  description         String
  image               String?
  baseBiddingPrice    Float
  isBiddingEnabled    Boolean
  technologies        String[]
  minimumRequirements String[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  adminId             Int
  category            String?
  deadline            DateTime?
  experienceLevel     String?
  bids                Bid[]
  admin               Admin      @relation(fields: [adminId], references: [id])
  savedByUsers        SavedJob[]

  @@index([adminId])
}

model User {
  id        Int          @id @default(autoincrement())
  email     String       @unique
  password  String
  bids      Bid[]
  chats     Chat[]
  savedJobs SavedJob[]
  profile   UserProfile?
}

model UserProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  name           String
  profilePicture String?
  title          String?
  bio            String?
  skills         String[]
  languages      String[]
  education      String?
  certifications String[]
  workHistory    String?
  availability   Boolean  @default(true)
  socialLinks    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Chat {
  id        Int       @id @default(autoincrement())
  adminId   Int
  userId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  admin     Admin     @relation(fields: [adminId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@unique([adminId, userId])
  @@index([adminId])
  @@index([userId])
}

model Message {
  id         Int      @id @default(autoincrement())
  chatId     Int
  senderId   Int
  senderType String   @default("admin")
  content    String
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id])

  @@index([chatId])
}

model SavedJob {
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([userId])
  @@index([jobId])
}
